{
    "name": "@thebridge/api",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24.11.0 <25"
    },
    "scripts": {
        "dev": "tsx watch --env-file=.env src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "typecheck": "tsc --noEmit",
        "test": "tsx --test test/**/*.test.ts",
        "test:sql": "node scripts/test-sql.mjs"
    },
    "dependencies": {
        "@supabase/supabase-js": "^2.112.3",
        "cors": "^2.8.5",
        "express": "^5.1.0",
        "helmet": "^8.1.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@electric-sql/pglite": "0.5.8",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.3",
        "@types/node": "^24.0.0",
        "tsx": "^4.20.0",
        "typescript": "^5.9.0"
    }
}
